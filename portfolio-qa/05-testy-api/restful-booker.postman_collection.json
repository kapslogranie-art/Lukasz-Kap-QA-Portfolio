{
  "info": {
    "name": "Restful-Booker — testy API (Łukasz Kap)",
    "description": "Kolekcja testów API dla https://restful-booker.herokuapp.com. Uruchamiać w podanej kolejności — token i bookingId zapisywane są w zmiennych kolekcji.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://restful-booker.herokuapp.com" },
    { "key": "token", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "firstname", "value": "" }
  ],
  "item": [
    {
      "name": "API-01 Health check",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));"
      ]}}],
      "request": { "method": "GET", "url": "{{baseUrl}}/ping" }
    },
    {
      "name": "API-02 Auth — poprawne dane",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Zwrócono token', () => {",
        "  pm.expect(body.token).to.be.a('string').and.not.empty;",
        "});",
        "pm.collectionVariables.set('token', body.token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/auth"
      }
    },
    {
      "name": "API-03 Auth — błędne hasło",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('Brak tokenu', () => pm.expect(body).to.not.have.property('token'));",
        "pm.test('Komunikat Bad credentials', () => pm.expect(body.reason).to.eql('Bad credentials'));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}" },
        "url": "{{baseUrl}}/auth"
      }
    },
    {
      "name": "API-04 Utworzenie rezerwacji",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "pm.collectionVariables.set('firstname', 'Lukasz' + Date.now());"
        ]}},
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('Status 200', () => pm.response.to.have.status(200));",
          "const body = pm.response.json();",
          "pm.test('bookingid jest liczbą', () => pm.expect(body.bookingid).to.be.a('number'));",
          "pm.test('Dane zgodne z wysłanymi', () => {",
          "  pm.expect(body.booking.firstname).to.eql(pm.collectionVariables.get('firstname'));",
          "  pm.expect(body.booking.lastname).to.eql('Kap');",
          "  pm.expect(body.booking.totalprice).to.eql(250);",
          "  pm.expect(body.booking.depositpaid).to.eql(true);",
          "  pm.expect(body.booking.bookingdates.checkin).to.eql('2026-10-01');",
          "});",
          "pm.collectionVariables.set('bookingId', body.bookingid);"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Kap\",\n  \"totalprice\": 250,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-10-01\",\n    \"checkout\": \"2026-10-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}" },
        "url": "{{baseUrl}}/booking"
      }
    },
    {
      "name": "API-05 Pobranie rezerwacji",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
        "const body = pm.response.json();",
        "pm.test('Dane zgodne z utworzoną rezerwacją', () => {",
        "  pm.expect(body.firstname).to.eql(pm.collectionVariables.get('firstname'));",
        "  pm.expect(body.bookingdates.checkout).to.eql('2026-10-05');",
        "});",
        "pm.test('Czas odpowiedzi < 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/booking/{{bookingId}}"
      }
    },
    {
      "name": "API-06 Filtrowanie po imieniu",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const ids = pm.response.json().map(b => b.bookingid);",
        "pm.test('Lista zawiera utworzoną rezerwację', () => {",
        "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId')));",
        "});"
      ]}}],
      "request": { "method": "GET", "url": "{{baseUrl}}/booking?firstname={{firstname}}" }
    },
    {
      "name": "API-07 Pełna aktualizacja (PUT) z tokenem",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Cena zaktualizowana', () => pm.expect(pm.response.json().totalprice).to.eql(300));"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Cookie", "value": "token={{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"Kap\",\n  \"totalprice\": 300,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-10-01\",\n    \"checkout\": \"2026-10-06\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}" },
        "url": "{{baseUrl}}/booking/{{bookingId}}"
      }
    },
    {
      "name": "API-08 Częściowa aktualizacja (PATCH)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Zmienione tylko additionalneeds', () => {",
        "  pm.expect(body.additionalneeds).to.eql('Dinner');",
        "  pm.expect(body.totalprice).to.eql(300);",
        "});"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Cookie", "value": "token={{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"additionalneeds\": \"Dinner\"\n}" },
        "url": "{{baseUrl}}/booking/{{bookingId}}"
      }
    },
    {
      "name": "API-09 Aktualizacja bez tokenu (negatywny)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 403', () => pm.response.to.have.status(403));"
      ]}}],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"firstname\": \"Hacker\"\n}" },
        "url": "{{baseUrl}}/booking/{{bookingId}}"
      }
    },
    {
      "name": "API-10 Usunięcie rezerwacji",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 201 (zachowanie tego API)', () => pm.response.to.have.status(201));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Cookie", "value": "token={{token}}" }],
        "url": "{{baseUrl}}/booking/{{bookingId}}"
      }
    },
    {
      "name": "API-11 Pobranie usuniętej rezerwacji",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));"
      ]}}],
      "request": { "method": "GET", "url": "{{baseUrl}}/booking/{{bookingId}}" }
    },
    {
      "name": "API-12 Nieistniejące ID",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));"
      ]}}],
      "request": { "method": "GET", "url": "{{baseUrl}}/booking/999999999" }
    }
  ]
}
